{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipboard-app",
  "version": "0.1.0",
  "identifier": "com.clipboard-app.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Clipboard",
        "label": "main",
        "width": 360,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "x": null,
        "y": null,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["sidebar"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
